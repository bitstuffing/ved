# Reproducible local test environment. Build and run with:
#   make test-container
FROM debian:stable-slim

RUN apt-get update \
 && apt-get install --yes --no-install-recommends \
      bash \
      ca-certificates \
      coreutils \
      findutils \
      shellcheck \
      tar \
      util-linux \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY . /workspace
RUN chmod +x ved tests/cli_test.sh tests/run.sh

CMD ["tests/run.sh", "--ci"]
